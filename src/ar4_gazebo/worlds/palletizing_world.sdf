<?xml version="1.0"?>
<!--
  palletizing_world.sdf — Gazebo Harmonic world for the AR4 palletizing cell.

  Layout (all sizes in metres; matches the measured URDF, 2026-11-21):
    - ground plane
    - linear track rail along Y (robot slides on it, joint_7, 0..0.45 m).
      Rail is the measured HGR15 (500 mm) on 8020 framing; the rail model is
      0.55 m long (framing length 551.56 mm). Track travel 0.45 m is an
      ESTIMATE — confirm from the limit switches.
    - conveyor belt on the +X side, 3 very small boxes on it (pick point).
      The arm reaches toward +X in its measured zero pose.
    - wooden pallet on the -X side (place point, fixed pose)
    - fixed camera on a pole above the pick point (eye-to-hand vision)

  PLACEHOLDERS — do NOT treat as the real design:
    - box size 0.05 m and box mass 0.1 kg: TBD — measure the real boxes
    - pallet size/pattern: TBD — boxes per row and number of layers not decided
    - conveyor length/height and camera height: TBD
  See README.md TODO list.
-->
<sdf version="1.10">
  <world name="palletizing_world">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Linear track rail along Y. Robot base slides on it (joint_7, 0..0.45 m).
         Rail centre (0.327, 0.242) is the measured HGR15 position; the 0.55 m
         length is the measured 8020 framing (551.56 mm). -->
    <model name="track_rail">
      <static>true</static>
      <pose>0.327 0.242 0.0265 0 0 0</pose>
      <link name="rail">
        <collision name="collision">
          <geometry><box><size>0.15 0.55 0.053</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.55 0.053</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Conveyor belt on the +X side (the arm reaches toward +X).
         Belt top at z = 0.35 m (PLACEHOLDER height).
         Pick point is above the belt at about (0.75, 0.24, 0.4). -->
    <model name="conveyor">
      <static>true</static>
      <pose>0.75 0.24 0.175 0 0 0</pose>
      <link name="belt">
        <collision name="collision">
          <geometry><box><size>0.3 0.8 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.8 0.35</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3 very small boxes on the conveyor, spaced along the track (Y).
         Box size 0.05 m and mass 0.1 kg are PLACEHOLDERS — MEASURE the real boxes. -->
    <model name="box_1">
      <pose>0.75 0.04 0.375 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <pose>0.75 0.24 0.375 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_3">
      <pose>0.75 0.44 0.375 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Wooden pallet on the -X side (fixed pose). Pallet size 0.4 x 0.4 m is a
         PLACEHOLDER; pallet pattern (boxes per row, layers) is TBD. -->
    <model name="pallet">
      <static>true</static>
      <pose>-0.25 0.24 0.06 0 0 0</pose>
      <link name="base">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.12</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.12</size></box></geometry><material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.6 0.45 0.25 1</diffuse></material></visual>
      </link>
      <!-- slats on top of the pallet -->
      <link name="slat_1">
        <pose>0 -0.12 0.07 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.4 0.08 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.08 0.02</size></box></geometry><material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material></visual>
      </link>
      <link name="slat_2">
        <pose>0 0.12 0.07 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.4 0.08 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.08 0.02</size></box></geometry><material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material></visual>
      </link>
      <joint name="slat_1_joint" type="fixed"><parent>base</parent><child>slat_1</child></joint>
      <joint name="slat_2_joint" type="fixed"><parent>base</parent><child>slat_2</child></joint>
    </model>

    <!-- Fixed camera above the pick point (eye-to-hand vision).
         Camera height 1.2 m is a PLACEHOLDER. The sensor looks straight down
         (Gazebo cameras look along the link's -Z axis) at the conveyor; its
         ROS image topic is bridged in config/gz_bridge.yaml. -->
    <model name="pick_camera">
      <static>true</static>
      <pose>0.75 0.24 0 0 0 0</pose>
      <link name="camera_assembly">
        <visual name="pole">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><box><size>0.04 0.04 1.2</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="camera_body">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>0 0 1.2 0 0 0</pose>
          <topic>/camera/image_raw</topic>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
