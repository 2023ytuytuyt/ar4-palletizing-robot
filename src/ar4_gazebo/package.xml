<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ar4_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic world and launch for the AR4 palletizing cell: linear track, conveyor with small boxes, pallet and fixed camera.</description>
  <maintainer email="ahmed@example.com">Ahmed</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ar4_description</depend>
  <depend>ar4_control</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
